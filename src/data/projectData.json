ate":11.81,"n":288},{"label":"technician","rate":11.06,"n":7597},{"label":"services","rate":8.88,"n":4154},{"label":"housemaid","rate":8.79,"n":1240},{"label":"entrepreneur","rate":8.27,"n":1487},{"label":"blue-collar","rate":7.27,"n":9732}]}]},"sql":{"queries":[{"title":"Total Customers","sql":"SELECT COUNT(*) AS total_customers\nFROM bank_marketing","columns":["total_customers"],"rows":[[45211]]},{"title":"Subscription Distribution","sql":"SELECT\n    y AS subscription_status,\n    COUNT(*) AS total_customers\nFROM bank_marketing\nGROUP BY y","columns":["subscription_status","total_customers"],"rows":[["no",39922],["yes",5289]]},{"title":"Subscription Rate (%)","sql":"SELECT\n    y,\n    COUNT(*) AS total_customers,\n    ROUND(\n        COUNT(*) * 100.0 /\n        (SELECT COUNT(*) FROM bank_marketing),\n        2\n    ) AS percentage\nFROM bank_marketing\nGROUP BY y","columns":["y","total_customers","percentage"],"rows":[["no",39922,88.3],["yes",5289,11.7]]},{"title":"Customer Distribution by Job","sql":"SELECT\n    job,\n    COUNT(*) AS total_customers\nFROM bank_marketing\nGROUP BY job\nORDER BY total_customers DESC","columns":["job","total_customers"],"rows":[["blue-collar",9732],["management",9458],["technician",7597],["admin.",5171],["services",4154],["retired",2264],["self-employed",1579],["entrepreneur",1487],["unemployed",1303],["housemaid",1240],["student",938],["unknown",288]]},{"title":"Conversion Rate by Job","sql":"SELECT\n    job,\n    COUNT(*) AS total_customers,\n    SUM(CASE WHEN y='yes' THEN 1 ELSE 0 END)\n        AS subscribed_customers,\n\n    ROUND(\n        SUM(CASE WHEN y='yes' THEN 1 ELSE 0 END)\n        *100.0 / COUNT(*),\n        2\n    ) AS conversion_rate\nFROM bank_marketing\nGROUP BY job\nORDER BY conversion_rate DESC","columns":["job","total_customers","subscribed_customers","conversion_rate"],"rows":[["student",938,269,28.68],["retired",2264,516,22.79],["unemployed",1303,202,15.5],["management",9458,1301,13.76],["admin.",5171,631,12.2],["self-employed",1579,187,11.84],["unknown",288,34,11.81],["technician",7597,840,11.06],["services",4154,369,8.88],["housemaid",1240,109,8.79],["entrepreneur",1487,123,8.27],["blue-collar",9732,708,7.27]]},{"title":"Ranking Job Categories by Conversion Rate","sql":"WITH job_conversion AS (\n    SELECT\n        job,\n        COUNT(*) AS total_customers,\n        SUM(\n            CASE\n                WHEN y='yes' THEN 1\n                ELSE 0\n            END\n        ) AS subscribed_customers,\n\n        ROUND(\n            SUM(\n                CASE\n                    WHEN y='yes' THEN 1\n                    ELSE 0\n                END\n            ) *100.0 / COUNT(*),\n            2\n        ) AS conversion_rate\n\n    FROM bank_marketing\n\n    GROUP BY job\n)\n\nSELECT\n    job,\n    total_customers,\n    subscribed_customers,\n    conversion_rate,\n\n    RANK() OVER(\n        ORDER BY conversion_rate DESC\n    ) AS conversion_rank\n\nFROM job_conversion","columns":["job","total_customers","subscribed_customers","conversion_rate","conversion_rank"],"rows":[["student",938,269,28.68,1],["retired",2264,516,22.79,2],["unemployed",1303,202,15.5,3],["management",9458,1301,13.76,4],["admin.",5171,631,12.2,5],["self-employed",1579,187,11.84,6],["unknown",288,34,11.81,7],["technician",7597,840,11.06,8],["services",4154,369,8.88,9],["housemaid",1240,109,8.79,10],["entrepreneur",1487,123,8.27,11],["blue-collar",9732,708,7.27,12]]},{"title":"Conversion Rate by Education","sql":"SELECT\n    education,\n    COUNT(*) AS total_customers,\n    SUM(CASE WHEN y='yes' THEN 1 ELSE 0 END) AS subscribed_customers,\n    ROUND(\n        SUM(CASE WHEN y='yes' THEN 1 ELSE 0 END) * 100.0 / COUNT(*),\n        2\n    ) AS conversion_rate\nFROM bank_marketing\nGROUP BY education\nORDER BY conversion_rate DESC","columns":["education","total_customers","subscribed_customers","conversion_rate"],"rows":[["tertiary",13301,1996,15.01],["unknown",1857,252,13.57],["secondary",23202,2450,10.56],["primary",6851,591,8.63]]},{"title":"Conversion Rate by Age Group","sql":"SELECT\n    CASE\n        WHEN age < 25 THEN '<25'\n        WHEN age BETWEEN 25 AND 34 THEN '25-34'\n        WHEN age BETWEEN 35 AND 44 THEN '35-44'\n        WHEN age BETWEEN 45 AND 54 THEN '45-54'\n        ELSE '55+'\n    END AS age_group,\n    COUNT(*) AS total_customers,\n    SUM(CASE WHEN y='yes' THEN 1 ELSE 0 END) AS subscribed_customers,\n    ROUND(\n        SUM(CASE WHEN y='yes' THEN 1 ELSE 0 END) * 100.0 / COUNT(*),\n        2\n    ) AS conversion_rate\nFROM bank_marketing\nGROUP BY age_group\nORDER BY conversion_rate DESC","columns":["age_group","total_customers","subscribed_customers","conversion_rate"],"rows":[["<25",809,207,25.59],["55+",5706,982,17.21],["25-34",14204,1773,12.48],["35-44",14534,1404,9.66],["45-54",9958,923,9.27]]},{"title":"Conversion Rate by Contact Method","sql":"SELECT\n    contact,\n    COUNT(*) AS total_customers,\n    SUM(CASE WHEN y='yes' THEN 1 ELSE 0 END) AS subscribed_customers,\n    ROUND(\n        SUM(CASE WHEN y='yes' THEN 1 ELSE 0 END) * 100.0 / COUNT(*),\n        2\n    ) AS conversion_rate\nFROM bank_marketing\nGROUP BY contact\nORDER BY conversion_rate DESC","columns":["contact","total_customers","subscribed_customers","conversion_rate"],"rows":[["cellular",29285,4369,14.92],["telephone",2906,390,13.42],["unknown",13020,530,4.07]]},{"title":"Conversion Rate by Month","sql":"SELECT\n    month,\n    COUNT(*) AS total_customers,\n    SUM(CASE WHEN y='yes' THEN 1 ELSE 0 END) AS subscribed_customers,\n    ROUND(\n        SUM(CASE WHEN y='yes' THEN 1 ELSE 0 END) * 100.0 / COUNT(*),\n        2\n    ) AS conversion_rate\nFROM bank_marketing\nGROUP BY month\nORDER BY conversion_rate DESC","columns":["month","total_customers","subscribed_customers","conversion_rate"],"rows":[["mar",477,248,51.99],["dec",214,100,46.73],["sep",579,269,46.46],["oct",738,323,43.77],["apr",2932,577,19.68],["feb",2649,441,16.65],["aug",6247,688,11.01],["jun",5341,546,10.22],["nov",3970,403,10.15],["jan",1403,142,10.12],["jul",6895,627,9.09],["may",13766,925,6.72]]},{"title":"Previous Campaign Outcome Analysis","sql":"SELECT\n    poutcome,\n    COUNT(*) AS total_customers,\n    SUM(CASE WHEN y='yes' THEN 1 ELSE 0 END)\n        AS subscribed_customers,\n\n    ROUND(\n        SUM(CASE WHEN y='yes' THEN 1 ELSE 0 END)\n        *100.0 / COUNT(*),\n        2\n    ) AS conversion_rate\n\nFROM bank_marketing\n\nGROUP BY poutcome\n\nORDER BY conversion_rate DESC","columns":["poutcome","total_customers","subscribed_customers","conversion_rate"],"rows":[["success",1511,978,64.73],["other",1840,307,16.68],["failure",4901,618,12.61],["unknown",36959,3386,9.16]]}]}}